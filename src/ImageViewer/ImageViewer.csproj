<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LightImageViewer</AssemblyName>
    <RootNamespace>ImageViewer</RootNamespace>
    <Product>LightImageViewer</Product>
    <Title>LightImageViewer</Title>
    <Description>LightImageViewer for Windows</Description>
    <Version>0.3.5</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.0" />
    <InternalsVisibleTo Include="ImageViewer.Tests" />
    <Resource Include="Assets/app.ico" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <Target Name="RemoveNativeDebugSymbolsFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb" />
  </Target>
</Project>
