<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightImageViewer" Width="1100" Height="760" MinWidth="460" MinHeight="300"
        WindowStartupLocation="CenterScreen" Background="#17191D" Foreground="#E9ECF1"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Icon="Assets/app.ico"
        AllowDrop="True" PreviewKeyDown="OnPreviewKeyDown" DragOver="OnDragOver" Drop="OnDrop">
  <Window.Resources>
    <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#D5D7DB" Geometry="M0,0 H20 V20 H0 Z" />
          <GeometryDrawing Brush="#AEB2BA" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2E3440" />
      <Setter Property="Foreground" Value="#F0F3F8" />
      <Setter Property="BorderBrush" Value="#505969" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#414B5D" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9CBFFE" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#52617A" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="2,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="ToolTipService.ShowDuration" Value="10000" />
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="IconPath" TargetType="Path">
      <Setter Property="Stroke" Value="#EDF1F7" /><Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border x:Name="Toolbar" Background="#21252C" BorderBrush="#343A44" BorderThickness="0,0,0,1" Padding="10,7">
      <WrapPanel VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Click="OnOpenClick" ToolTip="파일 열기 (Ctrl+O)" AutomationProperties.Name="파일 열기">
          <Path Style="{StaticResource IconPath}" Data="M1,15 V4 H7 L9,6 H18 L15,16 H1 L4,8 H18" />
        </Button>
        <Border Width="1" Height="22" Background="#505969" Margin="8,0" />
        <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Click="OnZoomOutClick" ToolTip="축소 (Ctrl + 마우스 휠 아래 / -)" AutomationProperties.Name="축소">
          <Path Style="{StaticResource IconPath}" Data="M3,9 H15" />
        </Button>
        <TextBlock x:Name="ZoomText" Text="—" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" ToolTip="원본 크기 기준 확대율" />
        <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Click="OnZoomInClick" ToolTip="확대 (Ctrl + 마우스 휠 위 / +)" AutomationProperties.Name="확대">
          <Path Style="{StaticResource IconPath}" Data="M3,9 H15 M9,3 V15" />
        </Button>
        <Button x:Name="ActualButton" Style="{StaticResource IconButton}" Click="OnActualClick" ToolTip="원본 크기 100% (1)" AutomationProperties.Name="원본 크기">
          <TextBlock Text="1:1" FontWeight="SemiBold" FontSize="12" />
        </Button>
        <Button x:Name="FitButton" Style="{StaticResource IconButton}" Click="OnFitClick" ToolTip="창에 맞추기 (F)" AutomationProperties.Name="창에 맞추기">
          <Path Style="{StaticResource IconPath}" Data="M1,1 H17 V17 H1 Z M4,9 H14 M7,6 L4,9 L7,12 M11,6 L14,9 L11,12" />
        </Button>
        <Border Width="1" Height="22" Background="#505969" Margin="8,0" />
        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Click="OnFullscreenClick" ToolTip="전체화면 (F11) · Esc로 복귀" AutomationProperties.Name="전체화면">
          <Path Style="{StaticResource IconPath}" Data="M1,6 V1 H6 M12,1 H17 V6 M17,12 V17 H12 M6,17 H1 V12 M1,1 L6,6 M17,1 L12,6 M17,17 L12,12 M1,17 L6,12" />
        </Button>
        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Click="OnPlayClick" ToolTip="애니메이션 재생 / 일시정지 (Space)" AutomationProperties.Name="재생 일시정지" Visibility="Collapsed">
          <TextBlock x:Name="PlayIcon" Text="Ⅱ" FontSize="16" FontWeight="Bold" />
        </Button>
        <StackPanel x:Name="PageControls" Orientation="Horizontal" Visibility="Collapsed" Margin="6,0,0,0">
          <Button Style="{StaticResource IconButton}" Click="OnPreviousPageClick" ToolTip="이전 TIFF 페이지 ([)" AutomationProperties.Name="이전 TIFF 페이지">
            <Path Style="{StaticResource IconPath}" Data="M12,3 L6,9 L12,15" />
          </Button>
          <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="6,0" />
          <Button Style="{StaticResource IconButton}" Click="OnNextPageClick" ToolTip="다음 TIFF 페이지 (])" AutomationProperties.Name="다음 TIFF 페이지">
            <Path Style="{StaticResource IconPath}" Data="M6,3 L12,9 L6,15" />
          </Button>
        </StackPanel>
      </WrapPanel>
    </Border>
    <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" Background="Transparent" SizeChanged="OnViewportSizeChanged"
          MouseWheel="OnMouseWheel" MouseLeftButtonDown="OnPanStart" MouseMove="OnPanMove"
          MouseLeftButtonUp="OnPanEnd" LostMouseCapture="OnPanCaptureLost">
      <Canvas IsHitTestVisible="False">
      <Border x:Name="ImageFrame"
              Background="{StaticResource Checkerboard}" Visibility="Collapsed">
        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
      </Canvas>
      <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
        <TextBlock Text="LightImageViewer" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="이미지를 여기에 놓아 주세요" Foreground="#BBC3D0" FontSize="16" Margin="0,18,0,20" HorizontalAlignment="Center" />
        <Button Content="파일 열기   Ctrl+O" Click="OnOpenClick" HorizontalAlignment="Center" AutomationProperties.Name="이미지 파일 열기" />
        <TextBlock Text="PNG · JPEG · WebP · BMP · GIF · TIFF · ICO" Foreground="#929CAC" Margin="0,22,0,0" HorizontalAlignment="Center" />
        <TextBlock Text="← ↑ Page Up  이전     /     다음  Page Down ↓ →" Foreground="#929CAC" Margin="0,12,0,0" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="MessagePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580" Margin="28">
        <TextBlock x:Name="MessageTitle" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock x:Name="MessageDetail" Foreground="#BBC3D0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" LineHeight="24" />
        <Button x:Name="RecoveryButton" Content="다른 파일 열기   Ctrl+O" Click="OnOpenClick" HorizontalAlignment="Center" Margin="0,22,0,0" />
      </StackPanel>
    </Grid>
    <Border x:Name="Statusbar" Grid.Row="2" Height="36" Background="#21252C" BorderBrush="#343A44" BorderThickness="0,1,0,0" Padding="14,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="IndexText" Text="0/0" MinWidth="64" Margin="0,0,20,0" />
        <TextBlock x:Name="ResolutionText" Text="— × —" MinWidth="102" Margin="0,0,20,0" />
        <TextBlock x:Name="FileSizeText" Text="— MB" MinWidth="80" Margin="0,0,20,0" />
        <TextBlock x:Name="StateText" Foreground="#A6B1C1" Text="파일을 열어 시작하세요" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
